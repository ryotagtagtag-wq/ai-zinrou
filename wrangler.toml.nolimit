name = "ai-zinrou"
main = "src/worker/worker.js"
compatibility_date = "2026-09-01"

[vars]
# 公開するなら、自分のページのオリジンに絞る (例: "https://example.pages.dev")
# file:// で開いて使う場合は "null" を含める。空欄なら全オリジン許可
ALLOWED_ORIGINS = ""
ALLOWED_MODELS = ""

[assets]
directory = "./public"
binding = "ASSETS"

[[ratelimits]]
name = "LIMITER"
# namespace_id は Cloudflare ダッシュボードまたは `wrangler rate-limit namespace create <name>` で取得する文字列
# 例: wrangler rate-limit namespace create ai_zinrou_rate_limit
# 取得した ID をここに記載する（本番値はリポジトリにコミットしないこと）
namespace_id = "987654321"
[ratelimits.simple]
limit = 20
period = 60
